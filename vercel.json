{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/",
      "destination": "/docs/html/contract_deployment_ide.html"
    },
    {
      "source": "/ade",
      "destination": "/docs/html/contract_deployment_ide.html"
    }
  ],
  "headers": [
    {
      "source": "/docs/html/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
